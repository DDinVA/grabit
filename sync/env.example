# grabit-sync environment
#
# Copy this file to /etc/grabit-sync/env on the sync host, populate the
# five values, and set the file to 0600 root:grabit-sync.
#
#   sudo install -m 0640 -o root -g grabit-sync sync/env.example /etc/grabit-sync/env
#   sudo $EDITOR /etc/grabit-sync/env
#
# The service reads this file via systemd's EnvironmentFile directive.
# Nothing in this file goes in the git repo.

# GitHub — fine-grained PAT scoped to DDinVA/grabit only.
# Permissions required: Issues (read+write), Metadata (read).
GITHUB_TOKEN=

# HMAC secret shared with the DDinVA/grabit repo webhook config.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# YouTrack.
YOUTRACK_URL=https://netsecdev.youtrack.cloud
YOUTRACK_TOKEN=
YOUTRACK_PROJECT=GRA

# Listen address for the inbound webhook receiver (behind Caddy).
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9987

# SQLite mapping DB.
STATE_DB=/var/lib/grabit-sync/state.db

# Pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
